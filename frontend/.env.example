# ==============================================================================
# Kitsuno.ai Frontend — Environment Configuration Template
# ==============================================================================
# In production, set these variables in your hosting provider (e.g., Vercel / Netlify / Cloudflare).
# In local development, copy this file to .env and adjust values as needed.

# URL of the deployed FastAPI backend (e.g. https://api.kitsuno.ai/api/v1)
VITE_API_BASE_URL=

# Supabase Project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous/Publishable Client Key (Public - safe to bundle in frontend)
VITE_SUPABASE_ANON_KEY=