# ==============================================================================
# Kitsuno.ai Backend — Environment Configuration Template
# ==============================================================================
# In production, set these variables in your hosting provider (e.g., Render / Railway / Fly.io).
# In local development, copy this file to .env and adjust values as needed.
# CRITICAL: NEVER COMMIT ACTUAL PRODUCTION SECRETS OR PASSWORDS.

# Application Identity & Mode
APP_NAME=AI Learning Platform API
ENVIRONMENT=production

# Database Connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# For Supabase in production, prefer the connection pooler URL (e.g. port 6543 / 5432)
DATABASE_URL=

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g., https://kitsuno.ai,https://www.kitsuno.ai)
# Note: In production mode, only origins listed here will be accepted.
CORS_ORIGINS=

# Supabase Auth & JWT Verification
# Supabase project URL used for JWKS ES256 verification and token issuer checks
SUPABASE_URL=
# Optional fallback secret for HS256 JWT signature verification
SUPABASE_JWT_SECRET=
# Designated platform admin email address (automatically granted ADMIN role upon first sign-in)
ADMIN_EMAIL=

# Local JWT Configuration (used for fallback tokens and automated test suites)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External AI Provider (backend-only credentials — NEVER expose to browser)
# Supported providers: "mock" (built-in deterministic generator) or "openai"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_QUESTIONS=20